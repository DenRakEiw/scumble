{
  "name": "scumble",
  "productName": "Scumble",
  "version": "0.0.1",
  "description": "Desktop editor for AI inpainting: layers, selection by text, retouch, filters, rendered through your own ComfyUI or API providers.",
  "author": "DenRakEiw",
  "license": "UNLICENSED",
  "private": true,
  "main": "electron/main/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:dir": "electron-builder --dir",
    "sync-editor": "python tools/sync_editor.py",
    "smoke": "python tools/smoke_test.py",
    "helpers-test": "node tools/helpers_test.js",
    "commands-test": "python tools/commands_test.py",
    "mcp-test": "python tools/mcp_test.py",
    "mcp": "electron . --mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "onnxruntime-node": "^1.29.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "app.scumble.desktop",
    "productName": "Scumble",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "recipes/**/*",
      "plugins/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "icon": "build/icon.png",
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Scumble Setup ${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Scumble",
      "perMachine": false
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Graphics",
      "artifactName": "scumble-${version}.${ext}"
    },
    "asarUnpack": [
      "node_modules/onnxruntime-node/bin/**"
    ]
  }
}
