{
  "id": "z_image",
  "kind": "provider",
  "name": "Z-Image [base]",
  "family": "Tongyi",
  "description": "Tongyi's full Z-Image. Text to image only: it has no editing endpoint, so it works in \"Generate new\", not in Generate. Model id from fal's model index on 2026-09-11; the adapter is written from the provider's schema and has not run against the live API yet.",
  "default": "fal",
  "providers": {
    "fal": {
      "model": "fal-ai/z-image/base",
      "edit": false,
      "settings": [
        {
          "index": 1,
          "key": "num_inference_steps",
          "label": "Steps",
          "spec": [
            "INT",
            {
              "default": 28,
              "min": 1,
              "max": 50
            }
          ]
        },
        {
          "index": 2,
          "key": "guidance_scale",
          "label": "Guidance",
          "spec": [
            "FLOAT",
            {
              "default": 4,
              "min": 1,
              "max": 20,
              "step": 0.5
            }
          ]
        },
        {
          "index": 3,
          "key": "acceleration",
          "label": "Acceleration",
          "spec": [
            [
              "none",
              "regular",
              "high"
            ],
            {
              "default": "regular"
            }
          ]
        }
      ],
      "note": "Text to image only. Use it from \"Generate new\"; the Generate button answers that this recipe has no edit path."
    }
  }
}
