{
  "id": "magnific_precision",
  "kind": "provider",
  "task": "upscale",
  "name": "Magnific Precision (upscale)",
  "family": "Upscale",
  "description": "Magnific's faithful upscaler (Precision V2): sharper, no invented content, 2 to 16 times. Every API call costs Magnific credits, whatever the web plan says. Written from the provider's schema and not run against the live API yet. Also on Comfy Cloud.",
  "default": "magnific",
  "factor": {
    "default": 2,
    "min": 2,
    "max": 16
  },
  "providers": {
    "magnific": {
      "model": "image-upscaler-precision-v2",
      "options": {
        "factor": "int"
      },
      "settings": [
        {
          "index": 1,
          "key": "flavor",
          "label": "Flavor",
          "spec": [
            [
              "photo",
              "sublime",
              "photo_denoiser"
            ],
            {
              "default": "photo"
            }
          ]
        },
        {
          "index": 2,
          "key": "sharpen",
          "label": "Sharpen",
          "spec": [
            "INT",
            {
              "default": 7,
              "min": 0,
              "max": 100
            }
          ]
        },
        {
          "index": 3,
          "key": "smart_grain",
          "label": "Smart grain",
          "spec": [
            "INT",
            {
              "default": 7,
              "min": 0,
              "max": 100
            }
          ]
        },
        {
          "index": 4,
          "key": "ultra_detail",
          "label": "Ultra detail",
          "spec": [
            "INT",
            {
              "default": 30,
              "min": 0,
              "max": 100
            }
          ]
        }
      ],
      "note": "POST /v1/ai/image-upscaler-precision-v2, an asynchronous task polled until it is done; the picture goes as base64 to Magnific (Freepik, Spain). Upscale (the button next to Generate) runs it on the selection, which comes back sharper at the document's resolution, or on the whole picture, which becomes N times larger with every layer scaled along."
    },
    "comfycloud": {
      "model": "MagnificImageUpscalerPreciseV2Node",
      "options": {
        "node": "MagnificImageUpscalerPreciseV2Node"
      },
      "settings": [
        {
          "index": 1,
          "key": "flavor",
          "label": "Flavor",
          "spec": [
            [
              "photo",
              "sublime",
              "photo_denoiser"
            ],
            {
              "default": "photo"
            }
          ]
        },
        {
          "index": 2,
          "key": "sharpen",
          "label": "Sharpen",
          "spec": [
            "INT",
            {
              "default": 7,
              "min": 0,
              "max": 100
            }
          ]
        },
        {
          "index": 3,
          "key": "smart_grain",
          "label": "Smart grain",
          "spec": [
            "INT",
            {
              "default": 7,
              "min": 0,
              "max": 100
            }
          ]
        },
        {
          "index": 4,
          "key": "ultra_detail",
          "label": "Ultra detail",
          "spec": [
            "INT",
            {
              "default": 30,
              "min": 0,
              "max": 100
            }
          ]
        }
      ],
      "note": "Runs as a Partner Node on Comfy Cloud (one Comfy key, billed in Comfy credits); not run against the live API yet. The node takes 2, 4, 8 or 16 times. Upscale (the button next to Generate) runs it on the selection, which comes back sharper at the document's resolution, or on the whole picture, which becomes N times larger with every layer scaled along.",
      "factor": {
        "default": 2,
        "min": 2,
        "max": 16,
        "steps": [
          2,
          4,
          8,
          16
        ]
      }
    }
  },
  "limits": {
    "min": 32,
    "max": 4096,
    "step": 1
  }
}
