{
  "id": "replicate_qwen_edit",
  "kind": "provider",
  "provider": "replicate",
  "model": "qwen/qwen-image-edit",
  "input": "edit",
  "fields": {
    "image": "image"
  },
  "name": "Qwen Image Edit via Replicate",
  "description": "Instruction-based editing of the crop (single image, no mask); the stitch keeps the selection. Needs a Replicate token.",
  "fixed": {
    "aspect_ratio": "match_input_image",
    "output_format": "png"
  },
  "settings": [
    {
      "index": 1,
      "key": "go_fast",
      "label": "Fast mode",
      "spec": [
        "BOOLEAN",
        {
          "default": true
        }
      ]
    }
  ]
}
