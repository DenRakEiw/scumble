{
  "id": "gpt_image_2_5_sunburst",
  "kind": "provider",
  "name": "GPT Image 2.5 Sunburst",
  "family": "OpenAI",
  "description": "OpenAI's high-fidelity image model (September 2026) for detail-rich edits; slower than Flare. Adapter written from the provider's docs, not run against the live API yet.",
  "default": "openai",
  "providers": {
    "openai": {
      "model": "gpt-image-2.5-sunburst",
      "input": "fill",
      "settings": [
        {
          "index": 1,
          "key": "quality",
          "label": "Quality",
          "spec": [
            [
              "auto",
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ],
            {
              "default": "auto"
            }
          ]
        },
        {
          "index": 2,
          "key": "size",
          "label": "Size",
          "spec": [
            [
              "auto",
              "1024x1024",
              "1536x1024",
              "1024x1536"
            ],
            {
              "default": "auto"
            }
          ]
        }
      ],
      "note": "OpenAI image edit with the selection as mask (transparent = repaint)."
    },
    "openrouter": {
      "model": "openai/gpt-image-2.5-sunburst",
      "input": "fill",
      "settings": [
        {
          "index": 2,
          "key": "quality",
          "label": "Quality",
          "spec": [
            [
              "auto",
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ],
            {
              "default": "auto"
            }
          ]
        }
      ],
      "note": "OpenRouter's unified image API; no mask input, the mask goes along as a reference and the prompt names the area."
    }
  }
}
