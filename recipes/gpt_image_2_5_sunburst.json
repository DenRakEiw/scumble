          "max": 3840,
          "minPixels": 655360,
          "maxPixels": 8294400,
          "maxRatio": 3
        },
        "transparent_only": true,
        "channels": {
          "official": {},
          "vip": {
            "model": "gpt-image-2.5-sunburst-vip"
          },
          "standard": {
