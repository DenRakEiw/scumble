      "spec": [
        "FLOAT",
        {
          "default": 60,
          "min": 1.5,
          "max": 100,
          "step": 0.5
        }
      ]
    },
    {
      "index": 3,
      "key": "safety_tolerance",
      "label": "Safety tolerance",
      "spec": [
        "INT",
        {
          "default": 2,
          "min": 0,
          "max": 6
        }
      ]
    },
    {
      "index": 4,
      "key": "prompt_upsampling",
      "label": "Prompt upsampling",
      "spec": [
        "BOOLEAN",
        {
          "default": false
        }
      ]
    }
  ]
