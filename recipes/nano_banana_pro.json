{
  "id": "nano_banana_pro",
  "kind": "provider",
  "name": "Nano Banana Pro (Gemini 3 Pro Image)",
  "family": "Google",
  "description": "Google's premium image model for complex edits, 1K to 4K. Adapter written from the provider's docs, not run against the live API yet.",
  "default": "gemini",
  "providers": {
    "gemini": {
      "model": "gemini-3-pro-image",
      "input": "fill",
      "settings": [
        {
          "index": 1,
          "key": "aspect_ratio",
          "label": "Aspect",
          "spec": [
            [
              "auto",
              "1:1",
              "3:2",
              "2:3",
              "4:3",
              "3:4",
              "16:9",
              "9:16"
            ],
            {
              "default": "auto"
            }
          ]
        },
        {
          "index": 2,
          "key": "image_size",
          "label": "Size",
          "spec": [
            [
              "auto",
              "1K",
              "2K",
              "4K"
            ],
            {
              "default": "auto"
            }
          ]
        }
      ],
      "note": "Gemini has no mask input: the crop and the mask go along and the prompt tells the model to change the white area only; the stitch keeps the selection."
    },
    "fal": {
      "model": "fal-ai/nano-banana-pro/edit",
      "input": "edit",
      "settings": [
        {
          "index": 1,
          "key": "resolution",
          "label": "Resolution",
          "spec": [
            [
              "0.5K",
              "1K",
              "2K",
              "4K"
            ],
            {
              "default": "1K"
            }
          ]
        },
        {
          "index": 2,
          "key": "safety_tolerance",
          "label": "Safety tolerance",
          "spec": [
            [
              "1",
              "2",
              "3",
              "4",
              "5",
              "6"
            ],
            {
              "default": "4"
            }
          ]
        }
      ],
      "note": "Instruction edit of the crop plus the reference layers, no mask input: the stitch keeps the selection. For area-directed edits set Fill to green and Original on, and say \"fill the green area\".",
      "options": {
        "sizing": "none"
      }
    },
    "replicate": {
      "model": "google/nano-banana-pro",
      "input": "edit",
      "fields": {
        "images": "image_input"
      },
      "fixed": {
        "output_format": "png",
        "aspect_ratio": "match_input_image"
      },
      "settings": [
        {
          "index": 1,
          "key": "resolution",
          "label": "Resolution",
          "spec": [
            [
              "1K",
              "2K",
              "4K"
            ],
            {
              "default": "1K"
            }
          ]
        }
      ],
      "note": "Instruction edit of the crop plus the reference layers, no mask input: the stitch keeps the selection. For area-directed edits set Fill to green and Original on, and say \"fill the green area\"."
    },
    "openrouter": {
      "model": "google/gemini-3-pro-image",
      "input": "fill",
      "settings": [
        {
          "index": 1,
          "key": "resolution",
          "label": "Resolution",
          "spec": [
            [
              "auto",
              "1K",
              "2K",
              "4K"
            ],
            {
              "default": "auto"
            }
          ]
        }
      ],
      "note": "OpenRouter's unified image API; no mask input, the mask goes along as a reference and the prompt names the area."
    }
  }
}
