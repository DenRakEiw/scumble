{
  "id": "flux3_klein_local",
  "name": "FLUX 3 Image Klein (ComfyUI)",
  "description": "FLUX 3 Image Klein on your own ComfyUI (0.41 or newer, which runs it on its own nodes): the crop plus up to three more pictures of the crop batch (the Original copy with a fill mode, then the reference layers) as reference latents at 1 MP each, sizes in steps of 16; the prompt goes as an edit of the crop, \"In <ref_image_0>, <your prompt> Keep everything else unchanged.\" (without it the model rebuilds the whole scene); inputs the batch does not fill are left out, and an @img token is written as the <ref_image_N> its picture has (the crop is <ref_image_0>). The step-distilled model at 16 steps and CFG 1 by default; the base model wants about 50 steps and CFG 4 (the Preset row has both). Which model file (distilled or base, any quantization), Qwen3-VL 4B text encoder and Flux.2 VAE it loads is picked under Settings; another text encoder (such as Flux.2 Klein's qwen_3_8b or qwen_3_4b) fails only in the sampler (\"mat1 and mat2 shapes cannot be multiplied\"), and Scumble then names the files the run sent. With the Boxes switch on, the boxes go as FLUX 3's rows through the Inpaint Canvas node's box_prompt output (a node from GitHub of 2026-10-15 or newer; an older one refuses the run). The files are in Black Forest Labs' flux-3-image-klein-comfy repository on Hugging Face (also in bf16 and nvfp4), which asks you to log in and accept the licence before a download; the weights are the FLUX Kommunity licence: read it there before using the pictures commercially.",
  "mode": "local",
  "canvas": "canvas",
  "result": "decode:0",
  "refs": { "name": "<ref_image_{n0}>", "slots": 4 },
  "boxes": { "schema": "flux3", "input": "say_in|string_b" },
  "needs": ["InpaintCanvas", "ImageFromBatch", "StringConcatenate", "UNETLoader", "CLIPLoader", "VAELoader", "ImageScaleToTotalPixels", "GetImageSize", "EmptyFlux2LatentImage", "BasicScheduler", "CLIPTextEncode", "VAEEncode", "ReferenceLatent", "CFGGuider", "RandomNoise", "KSamplerSelect", "SamplerCustomAdvanced", "VAEDecode"],
  "settings": [
    { "index": 1, "node": "unet", "input": "unet_name", "label": "Model" },
    { "index": 2, "node": "clip", "input": "clip_name", "label": "Text encoder" },
    { "index": 3, "node": "vae", "input": "vae_name", "label": "VAE" },
    { "index": 4, "node": "sched", "input": "steps", "label": "Steps" },
    { "index": 5, "node": "guider", "input": "cfg", "label": "CFG" },
    { "index": 6, "node": "scale0", "input": "megapixels", "label": "Megapixels" }
  ],
  "presets": [
    { "name": "Distilled: 16 steps, CFG 1", "values": { "sched:steps": 16, "guider:cfg": 1 } },
    { "name": "Base: 50 steps, CFG 4", "values": { "sched:steps": 50, "guider:cfg": 4 } }
  ],
  "models": {
    "diffusion_models": [
      "flux3-image-klein-int8-convrot.safetensors (https://huggingface.co/black-forest-labs/flux-3-image-klein-comfy/resolve/main/diffusion_models/flux3-image-klein-int8-convrot.safetensors)",
      "flux3-image-klein-base-int8-convrot.safetensors (https://huggingface.co/black-forest-labs/flux-3-image-klein-comfy/resolve/main/diffusion_models/flux3-image-klein-base-int8-convrot.safetensors)"
    ],
    "text_encoders": ["qwen3vl_4b_int8_convrot.safetensors (https://huggingface.co/black-forest-labs/flux-3-image-klein-comfy/resolve/main/text_encoders/qwen3vl_4b_int8_convrot.safetensors)"],
    "vae": ["flux2-vae.safetensors (https://huggingface.co/black-forest-labs/flux-3-image-klein-comfy/resolve/main/vae/flux2-vae.safetensors)"]
  },
  "prompt": {
    "canvas": { "class_type": "InpaintCanvas", "inputs": { "padding": 64, "target_size": 1024, "feather": 16, "multiple_of": 64 } },
    "img0": { "class_type": "ImageFromBatch", "inputs": { "image": ["canvas", 0], "batch_index": 0, "length": 1 } },
    "img1": { "class_type": "ImageFromBatch", "inputs": { "image": ["canvas", 0], "batch_index": 1, "length": 1 } },
    "img2": { "class_type": "ImageFromBatch", "inputs": { "image": ["canvas", 0], "batch_index": 2, "length": 1 } },
    "img3": { "class_type": "ImageFromBatch", "inputs": { "image": ["canvas", 0], "batch_index": 3, "length": 1 } },
    "unet": { "class_type": "UNETLoader", "inputs": { "unet_name": "flux3-image-klein-int8-convrot.safetensors", "weight_dtype": "default" } },
    "clip": { "class_type": "CLIPLoader", "inputs": { "clip_name": "qwen3vl_4b_int8_convrot.safetensors", "type": "flux3", "device": "default" } },
    "vae": { "class_type": "VAELoader", "inputs": { "vae_name": "flux2-vae.safetensors" } },
    "scale0": { "class_type": "ImageScaleToTotalPixels", "inputs": { "image": ["img0", 0], "upscale_method": "lanczos", "megapixels": 1, "resolution_steps": 16 } },
    "scale1": { "class_type": "ImageScaleToTotalPixels", "inputs": { "image": ["img1", 0], "upscale_method": "lanczos", "megapixels": 1, "resolution_steps": 16 } },
    "scale2": { "class_type": "ImageScaleToTotalPixels", "inputs": { "image": ["img2", 0], "upscale_method": "lanczos", "megapixels": 1, "resolution_steps": 16 } },
    "scale3": { "class_type": "ImageScaleToTotalPixels", "inputs": { "image": ["img3", 0], "upscale_method": "lanczos", "megapixels": 1, "resolution_steps": 16 } },
    "size": { "class_type": "GetImageSize", "inputs": { "image": ["scale0", 0] } },
    "latent": { "class_type": "EmptyFlux2LatentImage", "inputs": { "width": ["size", 0], "height": ["size", 1], "batch_size": 1 } },
    "sched": { "class_type": "BasicScheduler", "inputs": { "model": ["unet", 0], "scheduler": "simple", "steps": 16, "denoise": 1 } },
    "say_in": { "class_type": "StringConcatenate", "inputs": { "string_a": "In <ref_image_0>,", "string_b": ["canvas", 7], "delimiter": " " } },
    "say_keep": { "class_type": "StringConcatenate", "inputs": { "string_a": ["say_in", 0], "string_b": "Keep everything else unchanged.", "delimiter": " " } },
    "pos": { "class_type": "CLIPTextEncode", "inputs": { "clip": ["clip", 0], "text": ["say_keep", 0] } },
    "neg": { "class_type": "CLIPTextEncode", "inputs": { "clip": ["clip", 0], "text": "" } },
    "enc0": { "class_type": "VAEEncode", "inputs": { "pixels": ["scale0", 0], "vae": ["vae", 0] } },
    "enc1": { "class_type": "VAEEncode", "inputs": { "pixels": ["scale1", 0], "vae": ["vae", 0] } },
    "enc2": { "class_type": "VAEEncode", "inputs": { "pixels": ["scale2", 0], "vae": ["vae", 0] } },
    "enc3": { "class_type": "VAEEncode", "inputs": { "pixels": ["scale3", 0], "vae": ["vae", 0] } },
    "ref_pos0": { "class_type": "ReferenceLatent", "inputs": { "conditioning": ["pos", 0], "latent": ["enc0", 0] } },
    "ref_neg0": { "class_type": "ReferenceLatent", "inputs": { "conditioning": ["neg", 0], "latent": ["enc0", 0] } },
    "ref_pos1": { "class_type": "ReferenceLatent", "inputs": { "conditioning": ["ref_pos0", 0], "latent": ["enc1", 0] } },
    "ref_neg1": { "class_type": "ReferenceLatent", "inputs": { "conditioning": ["ref_neg0", 0], "latent": ["enc1", 0] } },
    "ref_pos2": { "class_type": "ReferenceLatent", "inputs": { "conditioning": ["ref_pos1", 0], "latent": ["enc2", 0] } },
    "ref_neg2": { "class_type": "ReferenceLatent", "inputs": { "conditioning": ["ref_neg1", 0], "latent": ["enc2", 0] } },
    "ref_pos3": { "class_type": "ReferenceLatent", "inputs": { "conditioning": ["ref_pos2", 0], "latent": ["enc3", 0] } },
    "ref_neg3": { "class_type": "ReferenceLatent", "inputs": { "conditioning": ["ref_neg2", 0], "latent": ["enc3", 0] } },
    "guider": { "class_type": "CFGGuider", "inputs": { "model": ["unet", 0], "positive": ["ref_pos3", 0], "negative": ["ref_neg3", 0], "cfg": 1 } },
    "noise": { "class_type": "RandomNoise", "inputs": { "noise_seed": ["canvas", 10] } },
    "sampler": { "class_type": "KSamplerSelect", "inputs": { "sampler_name": "euler" } },
    "run": { "class_type": "SamplerCustomAdvanced", "inputs": { "noise": ["noise", 0], "guider": ["guider", 0], "sampler": ["sampler", 0], "sigmas": ["sched", 0], "latent_image": ["latent", 0] } },
    "decode": { "class_type": "VAEDecode", "inputs": { "samples": ["run", 0], "vae": ["vae", 0] } }
  }
}
