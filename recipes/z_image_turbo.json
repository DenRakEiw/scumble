{
  "id": "z_image_turbo",
  "kind": "provider",
  "name": "Z-Image Turbo",
  "family": "Tongyi",
  "description": "Alibaba Tongyi's Z-Image Turbo, an 8-step model with a real mask inpainting endpoint on fal. Model id from fal's model index on 2026-09-11; the adapter is written from the provider's schema and has not run against the live API yet.",
  "default": "fal",
  "limits": {
    "max": 2048,
    "step": 16
  },
  "providers": {
    "fal": {
      "model": "fal-ai/z-image/turbo/inpaint",
      "input": "fill",
      "fields": {
        "mask": "mask_image_url"
      },
      "settings": [
        {
          "index": 1,
          "key": "num_inference_steps",
          "label": "Steps",
          "spec": [
            "INT",
            {
              "default": 8,
              "min": 1,
              "max": 8
            }
          ]
        },
        {
          "index": 2,
          "key": "strength",
          "label": "Strength",
          "spec": [
            "FLOAT",
            {
              "default": 1,
              "min": 0.05,
              "max": 1,
              "step": 0.01
            }
          ]
        },
        {
          "index": 3,
          "key": "guidance_scale",
          "label": "Guidance",
          "spec": [
            "FLOAT",
            {
              "default": 4,
              "min": 1,
              "max": 20,
              "step": 0.5
            }
          ]
        },
        {
          "index": 4,
          "key": "acceleration",
          "label": "Acceleration",
          "spec": [
            [
              "none",
              "regular",
              "high"
            ],
            {
              "default": "regular"
            }
          ]
        }
      ],
      "note": "Mask inpainting: the crop and the selection mask go to the model (mask_image_url), the stitch blends the answer back."
    }
  }
}
