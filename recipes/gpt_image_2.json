{
  "id": "gpt_image_2",
  "kind": "provider",
  "name": "GPT Image 2",
  "family": "OpenAI",
  "description": "OpenAI's April 2026 image model; custom sizes in multiples of 16. Also on WaveSpeedAI. Also on Comfy Cloud. Adapter written from the provider's docs, not run against the live API yet.",
  "default": "openai",
  "providers": {
    "openai": {
      "model": "gpt-image-2",
      "input": "fill",
      "settings": [
        {
          "index": 1,
          "key": "quality",
          "label": "Quality",
          "spec": [
            [
              "auto",
              "low",
              "medium",
              "high"
            ],
            {
              "default": "auto"
            }
          ]
        },
        {
          "index": 2,
          "key": "size",
          "label": "Size",
          "spec": [
            [
              "auto",
              "1024x1024",
              "1536x1024",
              "1024x1536"
            ],
            {
              "default": "auto"
            }
          ]
        },
        {
          "index": 3,
          "key": "input_fidelity",
          "label": "Input fidelity",
          "spec": [
            [
              "high",
              "low"
            ],
            {
              "default": "high"
            }
          ]
        }
      ],
      "note": "OpenAI image edit with the selection as mask (transparent = repaint)."
    },
    "fal": {
      "model": "openai/gpt-image-2/edit",
      "input": "fill",
      "options": {
        "sizing": "none"
      },
      "fields": {
        "images": "image_urls",
        "mask": "mask_url"
      },
      "settings": [
        {
          "index": 1,
          "key": "quality",
          "label": "Quality",
          "spec": [
            [
              "auto",
              "low",
              "medium",
              "high"
            ],
            {
              "default": "high"
            }
          ]
        }
      ],
      "note": "fal's hosted GPT Image 2 with the selection as mask_url; fal bills the OpenAI run."
    },
    "replicate": {
      "model": "openai/gpt-image-2",
      "input": "edit",
      "fields": {
        "images": "input_images"
      },
      "fixed": {
        "output_format": "png"
      },
      "settings": [
        {
          "index": 1,
          "key": "quality",
          "label": "Quality",
          "spec": [
            [
              "auto",
              "low",
              "medium",
              "high"
            ],
            {
              "default": "auto"
            }
          ]
        }
      ],
      "note": "Instruction edit of the crop plus the reference layers, no mask input: the stitch keeps the selection. For area-directed edits set Fill to green and Original on, and say \"fill the green area\"."
    },
    "wavespeed": {
      "model": "openai/gpt-image-2/edit",
      "input": "edit",
      "options": {
        "aspect_ratios": [
          "1:1",
          "3:2",
          "2:3",
          "3:4",
          "4:3",
          "4:5",
          "5:4",
          "9:16",
          "16:9",
          "21:9"
        ]
      },
      "settings": [
        {
          "index": 1,
          "key": "quality",
          "label": "Quality",
          "spec": [
            [
              "low",
              "medium",
              "high"
            ],
            {
              "default": "medium"
            }
          ]
        },
        {
          "index": 2,
          "key": "resolution",
          "label": "Resolution",
          "spec": [
            [
              "1k",
              "2k",
              "4k"
            ],
            {
              "default": "1k"
            }
          ]
        }
      ],
      "note": "Instruction edit of the crop plus the reference layers, no mask input: the stitch keeps the selection. For area-directed edits set Fill to green and Original on, and say \"fill the green area\". WaveSpeed sends the aspect preset closest to the crop."
    },
    "comfycloud": {
      "model": "gpt-image-2",
      "input": "fill",
      "options": {
        "node": "OpenAIGPTImageNodeV2",
        "mask": true
      },
      "settings": [
        {
          "index": 1,
          "key": "model.quality",
          "label": "Quality",
          "spec": [
            [
              "low",
              "medium",
              "high"
            ],
            {
              "default": "medium"
            }
          ]
        }
      ],
      "note": "Runs the Partner Node on Comfy Cloud (paid plan, credits). Mask inpainting through the node's mask input at the crop's size (multiples of 16)."
    }
  }
}
