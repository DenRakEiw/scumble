{
  "id": "gpt_image_2",
  "kind": "provider",
  "name": "GPT Image 2",
  "family": "OpenAI",
  "description": "OpenAI's April 2026 image model; custom sizes in multiples of 16. Also on WaveSpeedAI. Also on Comfy Cloud. Also on ToAPIs. Also on OpenRouter. Adapter written from the provider's docs, not run against the live API yet.",
  "default": "openai",
  "providers": {
    "toapis": {
      "model": "gpt-image-2-official",
      "input": "fill",
      "options": {
        "mask": true,
        "size": "ratio",
        "tiers": {
          "1k": 1024,
          "2k": 2048,
          "4k": 3840
        },
        "tier_key": "resolution",
        "tier_sizes": {
          "1:1": {
            "1k": "1024x1024",
            "2k": "2048x2048",
            "4k": "2880x2880"
          },
          "3:2": {
            "1k": "1536x1024",
            "2k": "2048x1360",
            "4k": "3520x2336"
          },
          "2:3": {
            "1k": "1024x1536",
            "2k": "1360x2048",
            "4k": "2336x3520"
          },
          "4:3": {
            "1k": "1024x768",
            "2k": "2048x1536",
            "4k": "3312x2480"
          },
          "3:4": {
            "1k": "768x1024",
            "2k": "1536x2048",
            "4k": "2480x3312"
          },
          "5:4": {
            "1k": "1280x1024",
            "2k": "2560x2048",
            "4k": "3216x2576"
          },
          "4:5": {
            "1k": "1024x1280",
            "2k": "2048x2560",
            "4k": "2576x3216"
          },
          "16:9": {
            "1k": "1536x864",
            "2k": "2048x1152",
            "4k": "3840x2160"
          },
          "9:16": {
            "1k": "864x1536",
            "2k": "1152x2048",
            "4k": "2160x3840"
          },
          "2:1": {
            "1k": "2048x1024",
            "2k": "2688x1344",
            "4k": "3840x1920"
          },
          "1:2": {
            "1k": "1024x2048",
            "2k": "1344x2688",
            "4k": "1920x3840"
          },
          "21:9": {
            "1k": "2016x864",
            "2k": "2688x1152",
            "4k": "3840x1648"
          },
          "9:21": {
            "1k": "864x2016",
            "2k": "1152x2688",
            "4k": "1648x3840"
          }
        },
        "max_images": 16,
        "channels": {
          "official": {},
          "vip": {
            "model": "gpt-image-2-vip",
            "mask": false
          },
          "standard": {
            "model": "gpt-image-2",
            "mask": false,
            "size": "preset",
            "ratios": [
              "1:1",
              "3:2",
              "2:3",
              "4:3",
              "3:4",
              "5:4",
              "4:5",
              "16:9",
              "9:16",
              "2:1",
              "1:2",
              "21:9",
              "9:21"
            ],
            "drop": [
              "quality"
            ],
            "transparent_only": true,
            "max_images": 6
          }
        }
      },
      "settings": [
        {
          "index": 1,
          "key": "channel",
          "label": "Channel",
          "spec": [
            [
              "official",
              "vip",
              "standard"
            ],
            {
              "default": "official"
            }
          ]
        },
        {
          "index": 2,
          "key": "quality",
          "label": "Quality",
          "spec": [
            [
              "low",
              "medium",
              "high"
            ],
            {
              "default": "high"
            }
          ]
        },
        {
          "index": 3,
          "key": "resolution",
          "label": "Resolution",
          "spec": [
            [
              "auto",
              "1k",
              "2k",
              "4k"
            ],
            {
              "default": "auto"
            }
          ]
        },
        {
          "index": 4,
          "key": "background",
          "label": "Background",
          "spec": [
            [
              "auto",
              "opaque",
              "transparent"
            ],
            {
              "default": "auto"
            }
          ]
        }
      ],
      "text": {
        "sizes": [
          1024,
          2048,
          3840
        ]
      },
      "note": "Runs on ToAPIs (a reseller); not run against the live API yet. Crop, mask and references are uploaded to public files.toapis.com URLs. Channel official is gpt-image-2-official on the vendor's own cloud: mask inpainting with the selection as mask_url (transparent = repaint) and the crop's own aspect ratio. vip (gpt-image-2-vip) and standard (gpt-image-2) cost a fraction and take no mask, so the stitch keeps the selection there; standard takes aspect presets and no quality. Resolution auto picks the smallest of 1k, 2k and 4k whose output covers the crop."
    },
    "openai": {
      "model": "gpt-image-2",
      "input": "fill",
      "settings": [
        {
          "index": 1,
          "key": "quality",
          "label": "Quality",
          "spec": [
            [
              "auto",
              "low",
              "medium",
              "high"
            ],
            {
              "default": "auto"
            }
          ]
        },
        {
          "index": 2,
          "key": "size",
          "label": "Size",
          "spec": [
            [
              "auto",
              "1024x1024",
              "1536x1024",
              "1024x1536"
            ],
            {
              "default": "auto"
            }
          ]
        },
        {
          "index": 5,
          "key": "background",
          "label": "Background",
          "spec": [
            [
              "auto",
              "opaque",
              "transparent"
            ],
            {
              "default": "auto"
            }
          ]
        },
        {
          "index": 6,
          "key": "output_format",
          "label": "File format",
          "spec": [
            [
              "png",
              "webp",
              "jpeg"
            ],
            {
              "default": "png"
            }
          ]
        },
        {
          "index": 7,
          "key": "output_compression",
          "label": "Compression",
          "spec": [
            "INT",
            {
              "default": 85,
              "min": 0,
              "max": 100,
              "step": 5
            }
          ]
        },
        {
          "index": 8,
          "key": "moderation",
          "label": "Moderation",
          "spec": [
            [
              "auto",
              "low"
            ],
            {
              "default": "auto"
            }
          ]
        }
      ],
      "note": "OpenAI image edit with the selection as mask (transparent = repaint). Background \"transparent\" asks for a cut-out with a real alpha channel: the result layer keeps it instead of the selection's composite mask, and colour match is skipped. PNG or WebP only, and say it in the prompt too (the \"Transparent asset\" template does)."
    },
    "fal": {
      "model": "openai/gpt-image-2/edit",
      "input": "fill",
      "options": {
        "sizing": "none"
      },
      "fields": {
        "images": "image_urls",
        "mask": "mask_url"
      },
      "settings": [
        {
          "index": 1,
          "key": "quality",
          "label": "Quality",
          "spec": [
            [
              "auto",
              "low",
              "medium",
              "high"
            ],
            {
              "default": "high"
            }
          ]
        }
      ],
      "note": "fal's hosted GPT Image 2 with the selection as mask_url; fal bills the OpenAI run."
    },
    "replicate": {
      "model": "openai/gpt-image-2",
      "input": "edit",
      "fields": {
        "images": "input_images"
      },
      "fixed": {
        "output_format": "png"
      },
      "settings": [
        {
          "index": 1,
          "key": "quality",
          "label": "Quality",
          "spec": [
            [
              "auto",
              "low",
              "medium",
              "high"
            ],
            {
              "default": "auto"
            }
          ]
        }
      ],
      "note": "Instruction edit of the crop plus the reference layers, no mask input: the stitch keeps the selection. For area-directed edits set Fill to green and Original on, and say \"fill the green area\"."
    },
    "wavespeed": {
      "model": "openai/gpt-image-2/edit",
      "input": "edit",
      "options": {
        "aspect_ratios": [
          "1:1",
          "3:2",
          "2:3",
          "3:4",
          "4:3",
          "4:5",
          "5:4",
          "9:16",
          "16:9",
          "21:9"
        ]
      },
      "settings": [
        {
          "index": 1,
          "key": "quality",
          "label": "Quality",
          "spec": [
            [
              "low",
              "medium",
              "high"
            ],
            {
              "default": "medium"
            }
          ]
        },
        {
          "index": 2,
          "key": "resolution",
          "label": "Resolution",
          "spec": [
            [
              "1k",
              "2k",
              "4k"
            ],
            {
              "default": "2k"
            }
          ]
        }
      ],
      "note": "Instruction edit of the crop plus the reference layers, no mask input: the stitch keeps the selection. For area-directed edits set Fill to green and Original on, and say \"fill the green area\". WaveSpeed sends the aspect preset closest to the crop."
    },
    "comfycloud": {
      "model": "gpt-image-2",
      "input": "fill",
      "options": {
        "node": "OpenAIGPTImageNodeV2",
        "mask": true
      },
      "settings": [
        {
          "index": 1,
          "key": "model.quality",
          "label": "Quality",
          "spec": [
            [
              "low",
              "medium",
              "high"
            ],
            {
              "default": "medium"
            }
          ]
        }
      ],
      "note": "Runs the Partner Node on Comfy Cloud (paid plan, credits). Mask inpainting through the node's mask input at the crop's size (multiples of 16)."
    },
    "openrouter": {
      "model": "openai/gpt-image-2",
      "input": "fill",
      "options": {
        "accepts": [
          "aspect_ratio",
          "quality",
          "n"
        ],
        "ratios": [
          "1:1",
          "3:2",
          "2:3",
          "4:3",
          "3:4",
          "16:9",
          "9:16",
          "21:9"
        ],
        "max_images": 16
      },
      "settings": [
        {
          "index": 1,
          "key": "quality",
          "label": "Quality",
          "spec": [
            [
              "auto",
              "low",
              "medium",
              "high"
            ],
            {
              "default": "auto"
            }
          ]
        }
      ],
      "limits": {
        "max": 2048,
        "step": 16,
        "pixels": 0,
        "minPixels": 0
      },
      "text": {
        "sizes": [
          1536
        ]
      },
      "note": "Runs on OpenRouter (one key for many models); not run against the live API yet. The pictures go inline in the request to OpenRouter, which passes them to OpenAI. No mask input on OpenRouter: the mask goes along as a second picture and the prompt says what it means; the stitch keeps the selection anyway. An edit sends no aspect, so the host keeps the crop's shape as its own edit endpoint does (not verified); an answer of another shape is centre-cropped. There is no size parameter: the host picks the output size (OpenRouter's one example is GPT Image 2 at 16:9 and high quality: 1536 x 864; no size is stated for other models or qualities). No transparent background: OpenRouter lists only auto and opaque for this model."
    }
  },
  "limits": {
    "max": 2048,
    "step": 16,
    "pixels": 8294400
  }
}
