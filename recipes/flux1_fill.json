{
  "id": "flux1_fill",
  "kind": "provider",
  "name": "FLUX.1 Fill [pro]",
  "family": "Black Forest Labs",
  "description": "Mask inpainting with the FLUX.1 fill model. Mask inpainting: the crop and the selection mask go to the model, the stitch blends the answer back. Adapter written from the provider's docs, not run against the live API yet.",
  "default": "bfl",
  "providers": {
    "bfl": {
      "model": "flux-pro-1.0-fill",
      "input": "fill",
      "settings": [
        {
          "index": 1,
          "key": "steps",
          "label": "Steps",
          "spec": [
            "INT",
            {
              "default": 50,
              "min": 15,
              "max": 50
            }
          ]
        },
        {
          "index": 2,
          "key": "guidance",
          "label": "Guidance",
          "spec": [
            "FLOAT",
            {
              "default": 60,
              "min": 1.5,
              "max": 100,
              "step": 0.5
            }
          ]
        },
        {
          "index": 3,
          "key": "safety_tolerance",
          "label": "Safety tolerance",
          "spec": [
            "INT",
            {
              "default": 2,
              "min": 0,
              "max": 6
            }
          ]
        },
        {
          "index": 4,
          "key": "prompt_upsampling",
          "label": "Prompt upsampling",
          "spec": [
            "BOOLEAN",
            {
              "default": false
            }
          ]
        }
      ]
    },
    "fal": {
      "model": "fal-ai/flux-pro/v1/fill",
      "input": "fill",
      "settings": [
        {
          "index": 1,
          "key": "safety_tolerance",
          "label": "Safety tolerance",
          "spec": [
            [
              "1",
              "2",
              "3",
              "4",
              "5",
              "6"
            ],
            {
              "default": "2"
            }
          ]
        },
        {
          "index": 2,
          "key": "enhance_prompt",
          "label": "Enhance prompt",
          "spec": [
            "BOOLEAN",
            {
              "default": false
            }
          ]
        }
      ]
    },
    "replicate": {
      "model": "black-forest-labs/flux-fill-pro",
      "input": "fill",
      "fields": {
        "image": "image",
        "mask": "mask"
      },
      "fixed": {
        "output_format": "png"
      },
      "settings": [
        {
          "index": 1,
          "key": "steps",
          "label": "Steps",
          "spec": [
            "INT",
            {
              "default": 50,
              "min": 15,
              "max": 50
            }
          ]
        },
        {
          "index": 2,
          "key": "guidance",
          "label": "Guidance",
          "spec": [
            "FLOAT",
            {
              "default": 60,
              "min": 2,
              "max": 100,
              "step": 0.5
            }
          ]
        },
        {
          "index": 3,
          "key": "safety_tolerance",
          "label": "Safety tolerance",
          "spec": [
            "INT",
            {
              "default": 2,
              "min": 1,
              "max": 6
            }
          ]
        },
        {
          "index": 4,
          "key": "prompt_upsampling",
          "label": "Prompt upsampling",
          "spec": [
            "BOOLEAN",
            {
              "default": false
            }
          ]
        }
      ]
    }
  }
}
