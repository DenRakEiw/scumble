{
  "id": "flux1_fill",
  "kind": "provider",
  "name": "FLUX.1 Fill [pro]",
  "family": "Black Forest Labs",
  "description": "Mask inpainting with the FLUX.1 fill model. Mask inpainting: the crop and the selection mask go to the model, the stitch blends the answer back. Also on WaveSpeedAI. Also on Comfy Cloud. Adapter written from the provider's docs, not run against the live API yet.",
  "default": "bfl",
  "providers": {
    "bfl": {
      "model": "flux-pro-1.0-fill",
      "input": "fill",
      "settings": [
        {
          "index": 1,
          "key": "steps",
          "label": "Steps",
          "spec": [
            "INT",
            {
              "default": 50,
              "min": 15,
              "max": 50
            }
          ]
        },
        {
          "index": 2,
          "key": "guidance",
          "label": "Guidance",
          "spec": [
            "FLOAT",
            {
              "default": 60,
              "min": 1.5,
              "max": 100,
              "step": 0.5
            }
          ]
        },
        {
          "index": 3,
          "key": "safety_tolerance",
          "label": "Safety tolerance",
          "spec": [
            "INT",
            {
              "default": 2,
              "min": 0,
              "max": 6
            }
          ]
        },
        {
          "index": 4,
          "key": "prompt_upsampling",
          "label": "Prompt upsampling",
          "spec": [
            "BOOLEAN",
            {
              "default": false
            }
          ]
        }
      ]
    },
    "fal": {
      "model": "fal-ai/flux-pro/v1/fill",
      "input": "fill",
      "settings": [
        {
          "index": 1,
          "key": "safety_tolerance",
          "label": "Safety tolerance",
          "spec": [
            [
              "1",
              "2",
              "3",
              "4",
              "5",
              "6"
            ],
            {
              "default": "2"
            }
          ]
        },
        {
          "index": 2,
          "key": "enhance_prompt",
          "label": "Enhance prompt",
          "spec": [
            "BOOLEAN",
            {
              "default": false
            }
          ]
        }
      ]
    },
    "replicate": {
      "model": "black-forest-labs/flux-fill-pro",
      "input": "fill",
      "fields": {
        "image": "image",
        "mask": "mask"
      },
      "fixed": {
        "output_format": "png"
      },
      "settings": [
        {
          "index": 1,
          "key": "steps",
          "label": "Steps",
          "spec": [
            "INT",
            {
              "default": 50,
              "min": 15,
              "max": 50
            }
          ]
        },
        {
          "index": 2,
          "key": "guidance",
          "label": "Guidance",
          "spec": [
            "FLOAT",
            {
              "default": 60,
              "min": 2,
              "max": 100,
              "step": 0.5
            }
          ]
        },
        {
          "index": 3,
          "key": "safety_tolerance",
          "label": "Safety tolerance",
          "spec": [
            "INT",
            {
              "default": 2,
              "min": 1,
              "max": 6
            }
          ]
        },
        {
          "index": 4,
          "key": "prompt_upsampling",
          "label": "Prompt upsampling",
          "spec": [
            "BOOLEAN",
            {
              "default": false
            }
          ]
        }
      ]
    },
    "wavespeed": {
      "model": "wavespeed-ai/flux-fill-dev",
      "input": "fill",
      "fields": {
        "image": "image",
        "mask": "mask_image"
      },
      "options": {
        "size": "star",
        "max_side": 1536,
        "negative": false
      },
      "settings": [
        {
          "index": 1,
          "key": "num_inference_steps",
          "label": "Steps",
          "spec": [
            "INT",
            {
              "default": 28,
              "min": 1,
              "max": 50
            }
          ]
        },
        {
          "index": 2,
          "key": "guidance_scale",
          "label": "Guidance",
          "spec": [
            "FLOAT",
            {
              "default": 30,
              "min": 28,
              "max": 35,
              "step": 0.5
            }
          ]
        }
      ],
      "note": "FLUX.1 Fill [dev] on WaveSpeed (the [pro] Fill is not hosted there): the crop and the selection mask go to the model at up to 1536 px, the stitch blends the answer back."
    },
    "comfycloud": {
      "model": "flux-pro-1.0-fill",
      "input": "fill",
      "options": {
        "node": "FluxProFillNode"
      },
      "settings": [
        {
          "index": 1,
          "key": "steps",
          "label": "Steps",
          "spec": [
            "INT",
            {
              "default": 50,
              "min": 15,
              "max": 50
            }
          ]
        },
        {
          "index": 2,
          "key": "guidance",
          "label": "Guidance",
          "spec": [
            "FLOAT",
            {
              "default": 60,
              "min": 1.5,
              "max": 100,
              "step": 0.5
            }
          ]
        },
        {
          "index": 3,
          "key": "prompt_upsampling",
          "label": "Prompt upsampling",
          "spec": [
            "BOOLEAN",
            {
              "default": false
            }
          ]
        }
      ],
      "note": "Runs the Partner Node on Comfy Cloud (paid plan, credits). Mask inpainting: the crop and the selection mask go to the Flux.1 Fill node, the stitch blends the answer back."
    }
  },
  "limits": {
    "max": 1440,
    "step": 32
  }
}
