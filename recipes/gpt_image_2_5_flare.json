{
  "id": "gpt_image_2_5_flare",
  "kind": "provider",
  "name": "GPT Image 2.5 Flare",
  "family": "OpenAI",
  "description": "OpenAI's fast image model (September 2026): custom sizes in multiples of 16 up to 3840 px an edge, quality up to max. Also on WaveSpeedAI. Also on Comfy Cloud. Adapter written from the provider's docs, not run against the live API yet.",
  "default": "openai",
  "providers": {
    "openai": {
      "model": "gpt-image-2.5-flare",
      "input": "fill",
      "settings": [
        {
          "index": 1,
          "key": "quality",
          "label": "Quality",
          "spec": [
            [
              "auto",
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ],
            {
              "default": "auto"
            }
          ]
        },
        {
          "index": 2,
          "key": "size",
          "label": "Size",
          "spec": [
            [
              "auto",
              "1024x1024",
              "1536x1024",
              "1024x1536"
            ],
            {
              "default": "auto"
            }
          ]
        },
        {
          "index": 5,
          "key": "background",
          "label": "Background",
          "spec": [
            [
              "auto",
              "opaque",
              "transparent"
            ],
            {
              "default": "auto"
            }
          ]
        },
        {
          "index": 6,
          "key": "output_format",
          "label": "File format",
          "spec": [
            [
              "png",
              "webp",
              "jpeg"
            ],
            {
              "default": "png"
            }
          ]
        },
        {
          "index": 7,
          "key": "output_compression",
          "label": "Compression",
          "spec": [
            "INT",
            {
              "default": 85,
              "min": 0,
              "max": 100,
              "step": 5
            }
          ]
        },
        {
          "index": 8,
          "key": "moderation",
          "label": "Moderation",
          "spec": [
            [
              "auto",
              "low"
            ],
            {
              "default": "auto"
            }
          ]
        }
      ],
      "note": "OpenAI image edit with the selection as mask (transparent = repaint). Background \"transparent\" asks for a cut-out with a real alpha channel: the result layer keeps it instead of the selection's composite mask, and colour match is skipped. PNG or WebP only, and say it in the prompt too (the \"Transparent asset\" template does).",
      "limits": {
        "max": 3840,
        "step": 16,
        "pixels": 8294400,
        "minPixels": 655360
      },
      "text": {
        "sizes": [
          1024,
          1536,
          2048,
          2560,
          3072,
          3840
        ]
      }
    },
    "wavespeed": {
      "model": "openai/gpt-image-2.5-flare/edit",
      "input": "edit",
      "options": {
        "aspect_ratios": [
          "1:1",
          "1:2",
          "2:1",
          "1:3",
          "3:1",
          "2:3",
          "3:2",
          "3:4",
          "4:3",
          "4:5",
          "5:4",
          "9:16",
          "16:9",
          "9:21",
          "21:9"
        ]
      },
      "settings": [
        {
          "index": 1,
          "key": "quality",
          "label": "Quality",
          "spec": [
            [
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ],
            {
              "default": "medium"
            }
          ]
        },
        {
          "index": 2,
          "key": "resolution",
          "label": "Resolution",
          "spec": [
            [
              "1k",
              "2k",
              "4k"
            ],
            {
              "default": "1k"
            }
          ]
        }
      ],
      "note": "Instruction edit of the crop plus the reference layers, no mask input: the stitch keeps the selection. For area-directed edits set Fill to green and Original on, and say \"fill the green area\". WaveSpeed sends the aspect preset closest to the crop."
    },
    "comfycloud": {
      "model": "gpt-image-2.5-flare",
      "input": "fill",
      "options": {
        "node": "OpenAIGPTImageNodeV2",
        "mask": true
      },
      "settings": [
        {
          "index": 1,
          "key": "model.quality",
          "label": "Quality",
          "spec": [
            [
              "low",
              "medium",
              "high",
              "xhigh",
              "max"
            ],
            {
              "default": "medium"
            }
          ]
        }
      ],
      "note": "Runs the Partner Node on Comfy Cloud (paid plan, credits). Mask inpainting through the node's mask input at the crop's size (multiples of 16)."
    }
  },
  "limits": {
    "max": 2048,
    "step": 16,
    "pixels": 8294400
  }
}
