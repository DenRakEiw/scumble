{
  "id": "gpt_image_1_5",
  "kind": "provider",
  "name": "GPT Image 1.5",
  "family": "OpenAI",
  "description": "OpenAI's December 2025 image model; three fixed sizes, a different aspect is center-cropped on stitch. Also on WaveSpeedAI. Also on Comfy Cloud. Adapter written from the provider's docs, not run against the live API yet.",
  "default": "openai",
  "providers": {
    "openai": {
      "model": "gpt-image-1.5",
      "input": "fill",
      "settings": [
        {
          "index": 1,
          "key": "quality",
          "label": "Quality",
          "spec": [
            [
              "auto",
              "low",
              "medium",
              "high"
            ],
            {
              "default": "auto"
            }
          ]
        },
        {
          "index": 2,
          "key": "size",
          "label": "Size",
          "spec": [
            [
              "auto",
              "1024x1024",
              "1536x1024",
              "1024x1536"
            ],
            {
              "default": "auto"
            }
          ]
        },
        {
          "index": 3,
          "key": "input_fidelity",
          "label": "Input fidelity",
          "spec": [
            [
              "high",
              "low"
            ],
            {
              "default": "high"
            }
          ]
        }
      ],
      "note": "OpenAI image edit with the selection as mask (transparent = repaint)."
    },
    "wavespeed": {
      "model": "openai/gpt-image-1.5/edit",
      "input": "edit",
      "settings": [
        {
          "index": 1,
          "key": "quality",
          "label": "Quality",
          "spec": [
            [
              "low",
              "medium",
              "high"
            ],
            {
              "default": "medium"
            }
          ]
        },
        {
          "index": 2,
          "key": "size",
          "label": "Size",
          "spec": [
            [
              "auto",
              "1024*1024",
              "1536*1024",
              "1024*1536"
            ],
            {
              "default": "auto"
            }
          ]
        },
        {
          "index": 3,
          "key": "input_fidelity",
          "label": "Input fidelity",
          "spec": [
            [
              "high",
              "low"
            ],
            {
              "default": "high"
            }
          ]
        }
      ],
      "note": "Instruction edit of the crop plus the reference layers, no mask input: the stitch keeps the selection. For area-directed edits set Fill to green and Original on, and say \"fill the green area\"."
    },
    "comfycloud": {
      "model": "gpt-image-1.5",
      "input": "fill",
      "options": {
        "node": "OpenAIGPTImageNodeV2",
        "mask": true
      },
      "settings": [
        {
          "index": 1,
          "key": "model.quality",
          "label": "Quality",
          "spec": [
            [
              "low",
              "medium",
              "high"
            ],
            {
              "default": "medium"
            }
          ]
        },
        {
          "index": 2,
          "key": "model.size",
          "label": "Size",
          "spec": [
            [
              "auto",
              "1024x1024",
              "1536x1024",
              "1024x1536"
            ],
            {
              "default": "auto"
            }
          ]
        }
      ],
      "note": "Runs the Partner Node on Comfy Cloud (paid plan, credits). Mask inpainting through the node's mask input."
    }
  }
}
