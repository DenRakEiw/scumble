{
  "id": "flux2_flex",
  "kind": "provider",
  "name": "FLUX.2 [flex]",
  "family": "Black Forest Labs",
  "description": "FLUX.2 with exposed steps and guidance, up to ten references. Also on WaveSpeedAI. Also on ToAPIs. Adapter written from the provider's docs, not run against the live API yet.",
  "default": "bfl",
  "providers": {
    "toapis": {
      "model": "flux-2-flex",
      "input": "edit",
      "options": {
        "size": "preset",
        "ratios": [
          "1:1",
          "4:3",
          "3:4",
          "16:9",
          "9:16",
          "3:2",
          "2:3"
        ],
        "tiers": {
          "1K": 1024,
          "2K": 2048
        },
        "tier_key": "metadata.resolution",
        "tier_sizes": {
          "1:1": {
            "1K": "1024x1024",
            "2K": "2048x2048"
          },
          "4:3": {
            "1K": "1365x1024",
            "2K": "2730x2048"
          },
          "3:4": {
            "1K": "1024x1365",
            "2K": "2048x2730"
          },
          "16:9": {
            "1K": "1820x1024",
            "2K": "3640x2048"
          },
          "9:16": {
            "1K": "1024x1820",
            "2K": "2048x3640"
          },
          "3:2": {
            "1K": "1536x1024",
            "2K": "3072x2048"
          },
          "2:3": {
            "1K": "1024x1536",
            "2K": "2048x3072"
          }
        },
        "max_images": 8
      },
      "settings": [
        {
          "index": 1,
          "key": "metadata.resolution",
          "label": "Resolution",
          "spec": [
            [
              "auto",
              "1K",
              "2K"
            ],
            {
              "default": "auto"
            }
          ]
        }
      ],
      "text": {
        "sizes": [
          1024,
          2048
        ]
      },
      "note": "Runs on ToAPIs (a reseller); not run against the live API yet. Crop, mask and references are uploaded to public files.toapis.com URLs. Instruction edit of the crop plus the reference layers, no mask input: the stitch keeps the selection. For area-directed edits set Fill to green and Original on, and say \"fill the green area\". The model takes aspect presets: a crop of another shape comes back re-framed and is centre-cropped. Up to seven reference layers; the crop keeps BFL's 1440 px ceiling until a live run shows what ToAPIs takes."
    },
    "bfl": {
      "model": "flux-2-flex",
      "input": "edit",
      "settings": [
        {
          "index": 1,
          "key": "steps",
          "label": "Steps",
          "spec": [
            "INT",
            {
              "default": 50,
              "min": 1,
              "max": 50
            }
          ]
        },
        {
          "index": 2,
          "key": "guidance",
          "label": "Guidance",
          "spec": [
            "FLOAT",
            {
              "default": 2.5,
              "min": 1,
              "max": 10,
              "step": 0.1
            }
          ]
        },
        {
          "index": 3,
          "key": "safety_tolerance",
          "label": "Safety tolerance",
          "spec": [
            "INT",
            {
              "default": 2,
              "min": 0,
              "max": 6
            }
          ]
        }
      ],
      "note": "Instruction edit of the crop plus the reference layers, no mask input: the stitch keeps the selection. For area-directed edits set Fill to green and Original on, and say \"fill the green area\"."
    },
    "fal": {
      "model": "fal-ai/flux-2-flex/edit",
      "input": "edit",
      "settings": [
        {
          "index": 1,
          "key": "num_inference_steps",
          "label": "Steps",
          "spec": [
            "INT",
            {
              "default": 50,
              "min": 1,
              "max": 50
            }
          ]
        },
        {
          "index": 2,
          "key": "guidance_scale",
          "label": "Guidance",
          "spec": [
            "FLOAT",
            {
              "default": 2.5,
              "min": 1,
              "max": 10,
              "step": 0.1
            }
          ]
        },
        {
          "index": 1,
          "key": "safety_tolerance",
          "label": "Safety tolerance",
          "spec": [
            [
              "1",
              "2",
              "3",
              "4",
              "5"
            ],
            {
              "default": "2"
            }
          ]
        }
      ],
      "note": "Instruction edit of the crop plus the reference layers, no mask input: the stitch keeps the selection. For area-directed edits set Fill to green and Original on, and say \"fill the green area\"."
    },
    "replicate": {
      "model": "black-forest-labs/flux-2-flex",
      "input": "edit",
      "fields": {
        "images": "input_images"
      },
      "fixed": {
        "output_format": "png",
        "aspect_ratio": "match_input_image"
      },
      "settings": [
        {
          "index": 1,
          "key": "steps",
          "label": "Steps",
          "spec": [
            "INT",
            {
              "default": 50,
              "min": 1,
              "max": 50
            }
          ]
        },
        {
          "index": 2,
          "key": "guidance",
          "label": "Guidance",
          "spec": [
            "FLOAT",
            {
              "default": 2.5,
              "min": 1,
              "max": 10,
              "step": 0.1
            }
          ]
        }
      ],
      "note": "Instruction edit of the crop plus the reference layers, no mask input: the stitch keeps the selection. For area-directed edits set Fill to green and Original on, and say \"fill the green area\"."
    },
    "wavespeed": {
      "model": "wavespeed-ai/flux-2-flex/edit",
      "input": "edit",
      "settings": [],
      "note": "Instruction edit of the crop plus the reference layers, no mask input: the stitch keeps the selection. For area-directed edits set Fill to green and Original on, and say \"fill the green area\"."
    }
  },
  "limits": {
    "max": 1440,
    "step": 32
  }
}
