{
 "model": "openai/gpt-image-2.6-flare/text-to-image",
 "source": "https://wavespeed.ai/models/openai/gpt-image-2.6-flare/text-to-image (the page's request_schema), read 2026-11-06",
 "components": {
  "schemas": {
   "Input": {
    "additionalProperties": false,
    "properties": {
     "aspect_ratio": {
      "default": "1:1",
      "description": "The aspect ratio of the generated image. Defaults to 1:1.",
      "enum": [
       "1:1",
       "1:2",
       "2:1",
       "1:3",
       "3:1",
       "2:3",
       "3:2",
       "3:4",
       "4:3",
       "4:5",
       "5:4",
       "9:16",
       "16:9",
       "9:21",
       "21:9"
      ],
      "type": "string",
      "x-placeholder": "Select aspect ratio"
     },
     "complexity": {
      "default": "high",
      "description": "How much planning the model does before drawing. Higher complexity improves layout and scene understanding on detailed prompts and takes a little longer; it does not change the price.",
      "enum": [
       "low",
       "medium",
       "high"
      ],
      "type": "string"
     },
     "frame_count": {
      "default": 9,
      "description": "GIF only: number of animation frames (2-16).",
      "maximum": 16,
      "minimum": 2,
      "type": "integer"
     },
     "frame_duration_ms": {
      "default": 200,
      "description": "GIF only: milliseconds per frame (20-2000).",
      "maximum": 2000,
      "minimum": 20,
      "type": "integer"
     },
     "output_format": {
      "default": "png",
      "description": "The format of the output image. gif returns an animation, svg a vector image.",
      "enum": [
       "png",
       "jpeg",
       "webp",
       "gif",
       "svg"
      ],
      "type": "string"
     },
     "prompt": {
      "description": "The positive prompt for the generation.",
      "type": "string"
     },
     "quality": {
      "default": "medium",
      "description": "Rendering quality. Higher tiers add detail and cost more: low is the fastest draft tier, medium is the balanced default, high, xhigh and max add fidelity.",
      "enum": [
       "low",
       "medium",
       "high",
       "xhigh",
       "max"
      ],
      "type": "string"
     },
     "resolution": {
      "default": "1k",
      "description": "The resolution of the output image.",
      "enum": [
       "1k",
       "2k",
       "4k"
      ],
      "type": "string"
     }
    },
    "required": [
     "prompt"
    ],
    "type": "object",
    "x-order-properties": [
     "prompt",
     "aspect_ratio",
     "resolution",
     "quality",
     "complexity",
     "output_format",
     "frame_count",
     "frame_duration_ms"
    ]
   }
  }
 }
}
