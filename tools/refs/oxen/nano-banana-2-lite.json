{
  "id": "nano-banana-2-lite",
  "endpoint": "/images/generate",
  "pricing": {
    "cost_per_image": 0.0442,
    "method": "per_image"
  },
  "request_schema": {
    "basic": [
      "input_image"
    ],
    "properties": {
      "aspect_ratio": {
        "default": "16:9",
        "enum": [
          "auto",
          "1:1",
          "16:9",
          "9:16",
          "4:3",
          "3:4",
          "3:2",
          "2:3",
          "4:5",
          "5:4",
          "21:9",
          "4:1",
          "1:4",
          "8:1",
          "1:8"
        ],
        "title": "Aspect Ratio",
        "type": "string",
        "x-order": 2
      },
      "input_image": {
        "description": "Optional reference image to edit. Leave empty to generate from the prompt alone. Reference it in the prompt as @Image1.",
        "items": {
          "format": "uri",
          "type": "string"
        },
        "nullable": true,
        "title": "Reference Images",
        "type": "array",
        "x-order": 1
      },
      "prompt": {
        "description": "Text description of what you want to generate, or the instruction on how to edit the given image. Use @Image1, @Image2, etc. to reference the input images.",
        "title": "Prompt",
        "type": "string",
        "x-media-references": {
          "groups": [
            {
              "field": "input_image",
              "pattern": "Image {n}"
            }
          ]
        },
        "x-order": 0
      },
      "resolution": {
        "default": "1K",
        "enum": [
          "1K"
        ],
        "title": "Resolution",
        "type": "string",
        "x-next-to": "aspect_ratio",
        "x-order": 3
      },
      "thinking_level": {
        "default": "minimal",
        "description": "How much the model reasons before generating. 'high' improves complex compositions at higher latency and cost.",
        "enum": [
          "minimal",
          "high"
        ],
        "title": "Thinking Level",
        "type": "string",
        "x-order": 4
      }
    },
    "required": [
      "prompt"
    ],
    "title": "Input",
    "type": "object"
  }
}
