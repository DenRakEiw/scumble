{
  "id": "gpt-image-2-5-sunburst",
  "endpoint": "/images/generate",
  "pricing": {
    "cost_per_image": 0.0517,
    "cost_per_image_grid": {
      "high": {
        "1K": 0.0369,
        "2K": 0.0517,
        "4K": 0.1301
      },
      "low": {
        "1K": 0.0041,
        "2K": 0.0058,
        "4K": 0.0145
      },
      "max": {
        "1K": 0.1477,
        "2K": 0.2067,
        "4K": 0.5203
      },
      "medium": {
        "1K": 0.0096,
        "2K": 0.0134,
        "4K": 0.0337
      },
      "xhigh": {
        "1K": 0.0656,
        "2K": 0.0919,
        "4K": 0.2313
      }
    },
    "method": "per_image"
  },
  "request_schema": {
    "basic": [
      "input_image"
    ],
    "properties": {
      "aspect_ratio": {
        "default": "16:9",
        "enum": [
          "auto",
          "1:1",
          "16:9",
          "9:16",
          "4:3",
          "3:4",
          "3:2",
          "2:3",
          "21:9",
          "9:21"
        ],
        "title": "Aspect Ratio",
        "type": "string",
        "x-order": 3
      },
      "background": {
        "default": "auto",
        "description": "Background of the generated image. 'transparent' requires png or webp output.",
        "enum": [
          "auto",
          "opaque",
          "transparent"
        ],
        "title": "Background",
        "type": "string",
        "x-order": 7
      },
      "input_image": {
        "description": "Optional reference image(s) to edit, up to 16. Leave empty to generate from the prompt alone.",
        "items": {
          "format": "uri",
          "type": "string"
        },
        "nullable": true,
        "title": "Reference Images",
        "type": "array",
        "x-order": 1
      },
      "mask_url": {
        "description": "Optional mask image URL for inpainting. Transparent pixels mark regions to edit; opaque pixels are preserved. Must match the first reference image's size. Leave empty to edit the whole image.",
        "format": "uri",
        "nullable": true,
        "title": "Mask",
        "type": "string",
        "x-order": 2
      },
      "moderation": {
        "default": "low",
        "description": "Content moderation strictness. 'low' is less restrictive than 'auto'; OpenAI still filters all prompts and outputs under its usage policies.",
        "enum": [
          "low",
          "auto"
        ],
        "title": "Moderation",
        "type": "string",
        "x-order": 8
      },
      "output_format": {
        "default": "png",
        "description": "File format for the generated image.",
        "enum": [
          "png",
          "jpeg",
          "webp"
        ],
        "title": "Output Format",
        "type": "string",
        "x-order": 6
      },
      "prompt": {
        "description": "Text description of the image to generate, or the instruction on how to edit the reference images. Use @Image1, @Image2, etc. to reference the input images.",
        "title": "Prompt",
        "type": "string",
        "x-media-references": {
          "groups": [
            {
              "field": "input_image",
              "pattern": "Image {n}"
            }
          ]
        },
        "x-order": 0
      },
      "quality": {
        "default": "high",
        "description": "Output quality tier. Higher tiers render more detail and cost more; xhigh and max are the slowest and most detailed.",
        "enum": [
          "low",
          "medium",
          "high",
          "xhigh",
          "max"
        ],
        "title": "Quality",
        "type": "string",
        "x-order": 5
      },
      "resolution": {
        "default": "2K",
        "enum": [
          "1K",
          "2K",
          "4K"
        ],
        "title": "Resolution",
        "type": "string",
        "x-next-to": "aspect_ratio",
        "x-order": 4
      }
    },
    "required": [
      "prompt"
    ],
    "title": "Input",
    "type": "object"
  }
}
