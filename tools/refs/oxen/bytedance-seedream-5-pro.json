{
  "id": "bytedance-seedream-5-pro",
  "endpoint": "/images/generate",
  "pricing": {
    "cost_per_image": 0.045,
    "method": "per_image"
  },
  "request_schema": {
    "basic": [
      "input_image"
    ],
    "properties": {
      "aspect_ratio": {
        "default": "1:1",
        "enum": [
          "1:1",
          "4:3",
          "3:4",
          "16:9",
          "9:16",
          "3:2",
          "2:3",
          "21:9"
        ],
        "title": "Aspect Ratio",
        "type": "string",
        "x-order": 2
      },
      "input_image": {
        "description": "Optional reference image URLs for image-to-image editing. Provide one image for single-image editing or multiple for multi-reference fusion; reference them in the prompt as @Image1, @Image2, etc. Up to 10 images.",
        "items": {
          "format": "uri",
          "type": "string"
        },
        "maxItems": 10,
        "title": "Reference Images",
        "type": "array",
        "x-order": 1
      },
      "output_format": {
        "default": "png",
        "description": "Output image format.",
        "enum": [
          "png",
          "jpeg"
        ],
        "title": "Output Format",
        "type": "string",
        "x-order": 4
      },
      "prompt": {
        "description": "Text prompt for image generation, or the instruction for editing the input images. Use @Image1, @Image2, etc. to reference the input images.",
        "title": "Prompt",
        "type": "string",
        "x-media-references": {
          "groups": [
            {
              "field": "input_image",
              "pattern": "Image {n}"
            }
          ]
        },
        "x-order": 0
      },
      "size": {
        "default": "2K",
        "description": "Resolution level. Combined with the aspect ratio to set the output dimensions.",
        "enum": [
          "1K",
          "2K"
        ],
        "title": "Resolution",
        "type": "string",
        "x-order": 3
      },
      "watermark": {
        "default": false,
        "description": "Whether to add an 'AI generated' watermark.",
        "title": "Watermark",
        "type": "boolean",
        "x-order": 5
      }
    },
    "required": [
      "prompt"
    ],
    "title": "Input",
    "type": "object"
  }
}
