{
 "openapi": "3.1.0",
 "info": {
  "title": "Queue OpenAPI for fal-ai/gpt-image-2.5-flare/edit",
  "version": "1.0.0",
  "description": "The OpenAPI schema for the fal-ai/gpt-image-2.5-flare/edit queue.",
  "x-fal-metadata": {
   "endpointId": "fal-ai/gpt-image-2.5-flare/edit",
   "playgroundUrl": "https://fal.ai/models/fal-ai/gpt-image-2.5-flare/edit",
   "documentationUrl": "https://fal.ai/models/fal-ai/gpt-image-2.5-flare/edit/api",
   "about": "Edit images with the selected GPT Image 2.5 model."
  }
 },
 "components": {
  "securitySchemes": {
   "apiKeyAuth": {
    "type": "apiKey",
    "in": "header",
    "name": "Authorization",
    "description": "Fal Key"
   }
  },
  "schemas": {
   "QueueStatus": {
    "type": "object",
    "properties": {
     "status": {
      "type": "string",
      "enum": [
       "IN_QUEUE",
       "IN_PROGRESS",
       "COMPLETED"
      ]
     },
     "request_id": {
      "type": "string",
      "description": "The request id."
     },
     "response_url": {
      "type": "string",
      "description": "The response url."
     },
     "status_url": {
      "type": "string",
      "description": "The status url."
     },
     "cancel_url": {
      "type": "string",
      "description": "The cancel url."
     },
     "logs": {
      "type": "object",
      "description": "The logs.",
      "additionalProperties": true
     },
     "metrics": {
      "type": "object",
      "description": "The metrics.",
      "additionalProperties": true
     },
     "queue_position": {
      "type": "integer",
      "description": "The queue position."
     }
    },
    "required": [
     "status",
     "request_id"
    ]
   },
   "GptImage25FlareEditInput": {
    "description": "GPT Image 2.5 edit inputs with model-specific quality and compression.",
    "properties": {
     "output_compression": {
      "description": "Compression level from 0 to 100. Only supported when output_format is 'jpeg' or 'webp'.",
      "title": "Output Compression",
      "anyOf": [
       {
        "maximum": 100,
        "minimum": 0,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     },
     "prompt": {
      "description": "The prompt for image generation",
      "maxLength": 32000,
      "type": "string",
      "title": "Prompt",
      "examples": [
       "Same workers, same beam, same lunch boxes - but they're all on their phones now. One is taking a selfie. One is on a call looking annoyed. Same danger, new priorities. A hard hat has AirPods."
      ],
      "minLength": 1
     },
     "num_images": {
      "description": "Number of images to generate",
      "maximum": 10,
      "default": 1,
      "minimum": 1,
      "title": "Number of Images",
      "examples": [
       1
      ],
      "type": "integer"
     },
     "sync_mode": {
      "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history.",
      "default": false,
      "title": "Sync Mode",
      "type": "boolean"
     },
     "mask_url": {
      "description": "Mask image URL. White marks regions to edit and black marks regions to keep.",
      "title": "Mask URL",
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "background": {
      "description": "Background for the generated image",
      "enum": [
       "auto",
       "transparent",
       "opaque"
      ],
      "default": "auto",
      "title": "Background",
      "type": "string"
     },
     "output_format": {
      "description": "Output format for the images",
      "enum": [
       "jpeg",
       "png",
       "webp"
      ],
      "default": "png",
      "title": "Output Format",
      "type": "string"
     },
     "quality": {
      "description": "Quality for the generated image. Higher settings increase detail, latency, and token usage. Use 'auto' to let the model choose.",
      "enum": [
       "auto",
       "low",
       "medium",
       "high",
       "xhigh",
       "max"
      ],
      "title": "Quality",
      "type": "string",
      "default": "high"
     },
     "image_size": {
      "description": "The size of the generated image. Use 'auto' to infer from input images.",
      "default": "auto",
      "title": "Image Size",
      "anyOf": [
       {
        "$ref": "#/components/schemas/ImageSize"
       },
       {
        "enum": [
         "square_hd",
         "square",
         "portrait_4_3",
         "portrait_16_9",
         "landscape_4_3",
         "landscape_16_9",
         "auto"
        ],
        "type": "string"
       }
      ]
     },
     "enable_safety_checker": {
      "description": "Authorized callers may set false to request relaxed screening.",
      "default": true,
      "title": "Enable Safety Checker",
      "type": "boolean"
     },
     "image_urls": {
      "description": "The URLs of the images to use as a reference for the generation. A maximum of 16 images are allowed.",
      "title": "Image URLs",
      "type": "array",
      "examples": [
       [
        "https://v3b.fal.media/files/b/0a8691af/9Se_1_VX1wzTjjTOpWbs9_bb39c2eb-1a41-4749-b1d0-cf134abc8bbf.png"
       ]
      ],
      "items": {
       "type": "string"
      },
      "maxItems": 16
     }
    },
    "x-fal-order-properties": [
     "prompt",
     "image_urls",
     "mask_url",
     "image_size",
     "background",
     "quality",
     "num_images",
     "output_format",
     "output_compression",
     "sync_mode",
     "enable_safety_checker"
    ],
    "title": "GPTImage25EditImageRequest",
    "required": [
     "prompt",
     "image_urls"
    ],
    "type": "object"
   },
   "GptImage25FlareEditOutput": {
    "properties": {
     "images": {
      "description": "The generated images.",
      "title": "Images",
      "type": "array",
      "examples": [
       [
        {
         "height": 1024,
         "width": 1024,
         "content_type": "image/png",
         "file_name": "yUt7tifLSbg1WzWWgfj2o.png",
         "url": "https://v3b.fal.media/files/b/0a8691b0/yUt7tifLSbg1WzWWgfj2o.png"
        }
       ]
      ],
      "items": {
       "$ref": "#/components/schemas/ImageFile"
      }
     }
    },
    "x-fal-order-properties": [
     "images"
    ],
    "title": "EditImageResponse",
    "required": [
     "images"
    ],
    "type": "object"
   },
   "ImageSize": {
    "properties": {
     "height": {
      "description": "The height of the generated image.",
      "maximum": 14142,
      "exclusiveMinimum": 0,
      "title": "Height",
      "type": "integer",
      "default": 512
     },
     "width": {
      "description": "The width of the generated image.",
      "maximum": 14142,
      "exclusiveMinimum": 0,
      "title": "Width",
      "type": "integer",
      "default": 512
     }
    },
    "x-fal-order-properties": [
     "width",
     "height"
    ],
    "title": "ImageSize",
    "type": "object"
   },
   "ImageFile": {
    "properties": {
     "height": {
      "description": "The height of the image",
      "title": "Height",
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     },
     "file_size": {
      "description": "The size of the file in bytes.",
      "title": "File Size",
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "examples": [
       4404019
      ]
     },
     "width": {
      "description": "The width of the image",
      "title": "Width",
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     },
     "content_type": {
      "description": "The mime type of the file.",
      "title": "Content Type",
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "examples": [
       "image/png"
      ]
     },
     "file_name": {
      "description": "The name of the file. It will be auto-generated if not provided.",
      "title": "File Name",
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "examples": [
       "z9RV14K95DvU.png"
      ]
     },
     "url": {
      "description": "The URL where the file can be downloaded from.",
      "title": "Url",
      "type": "string"
     }
    },
    "x-fal-order-properties": [
     "url",
     "content_type",
     "file_name",
     "file_size",
     "width",
     "height"
    ],
    "title": "ImageFile",
    "required": [
     "url"
    ],
    "type": "object"
   }
  }
 },
