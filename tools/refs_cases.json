{
  "_comment": "The @img token grammar (docs/PLAN_REFS.md C1) and marker-resolution vectors, shared by tools/refs_layout_test.js (electron/main/providers/refs.js), tools/reftokens_test.js (renderer/editor/reftokens.js) and 26e's comfyrefs_test.js, so the regex in main and the one in the renderer cannot drift apart. tokens: every token found, in order; n for a live token, id for a parked one.",
  "grammar": [
    { "text": "@img1", "tokens": [{ "text": "@img1", "n": 1 }] },
    { "text": "@IMG2", "tokens": [{ "text": "@IMG2", "n": 2 }] },
    { "text": "@Img3 and @iMg4", "tokens": [{ "text": "@Img3", "n": 3 }, { "text": "@iMg4", "n": 4 }] },
    { "text": "@img12", "tokens": [{ "text": "@img12", "n": 12 }] },
    { "text": "@img999", "tokens": [{ "text": "@img999", "n": 999 }] },
    { "text": "@img?Lk3x9", "tokens": [{ "text": "@img?Lk3x9", "id": "Lk3x9" }] },
    { "text": "@IMG?Labc", "tokens": [{ "text": "@IMG?Labc", "id": "Labc" }] },
    { "text": "@img?labc", "tokens": [] },
    { "text": "@img?L", "tokens": [] },
    { "text": "@img?LAbc", "tokens": [] },
    { "text": "@img0", "tokens": [] },
    { "text": "@img01", "tokens": [] },
    { "text": "@img1234", "tokens": [] },
    { "text": "@img", "tokens": [] },
    { "text": "x@img1", "tokens": [] },
    { "text": "_@img1", "tokens": [] },
    { "text": "-@img1", "tokens": [] },
    { "text": "@img1-a", "tokens": [] },
    { "text": "@img1_a", "tokens": [] },
    { "text": "@img1a", "tokens": [] },
    { "text": "@image2", "tokens": [] },
    { "text": "@Image2", "tokens": [] },
    { "text": "mail@img1.de", "tokens": [] },
    { "text": "@img1.", "tokens": [{ "text": "@img1", "n": 1 }] },
    { "text": "@img1,", "tokens": [{ "text": "@img1", "n": 1 }] },
    { "text": "(@img2)", "tokens": [{ "text": "@img2", "n": 2 }] },
    { "text": "\"@img2\"", "tokens": [{ "text": "@img2", "n": 2 }] },
    { "text": "the coat from @img1, the hat from @img2", "tokens": [{ "text": "@img1", "n": 1 }, { "text": "@img2", "n": 2 }] },
    { "text": "@img1@img2", "tokens": [{ "text": "@img1", "n": 1 }] },
    { "text": "@img1 @img1", "tokens": [{ "text": "@img1", "n": 1 }, { "text": "@img1", "n": 1 }] },
    { "text": "line\n@img2\n", "tokens": [{ "text": "@img2", "n": 2 }] },
    { "text": "{@ref:1}", "tokens": [] },
    { "text": "@@img1", "tokens": [{ "text": "@img1", "n": 1 }] }
  ],
  "markers": [
    {
      "_comment": "a fill on OpenAI direct with the Original and one reference: crop, Original, reference; the mask in a field of its own",
      "text": "the coat from {@ref:1}",
      "pictures": [
        { "role": "crop", "field": "image[][0]", "n": 1 },
        { "role": "original", "ref": 0, "field": "image[][1]", "n": 2 },
        { "role": "reference", "ref": 1, "field": "image[][2]", "n": 3 },
        { "role": "mask", "field": "mask", "n": null }
      ],
      "pattern": "Image {n}",
      "out": "the coat from Image 3",
      "left": [],
      "refs": [{ "ref": 1, "name": "Image 3" }]
    },
    {
      "_comment": "the same picture on OpenRouter, where the mask is picture 2",
      "text": "the coat from {@ref:1}",
      "pictures": [
        { "role": "crop", "field": "input_references[0]", "n": 1 },
        { "role": "mask", "field": "input_references[1]", "n": 2 },
        { "role": "original", "ref": 0, "field": "input_references[2]", "n": 3 },
        { "role": "reference", "ref": 1, "field": "input_references[3]", "n": 4 }
      ],
      "pattern": "Image {n}",
      "out": "the coat from Image 4",
      "left": [],
      "refs": [{ "ref": 1, "name": "Image 4" }]
    },
    {
      "_comment": "0-based names, a marker twice, the Original named",
      "text": "{@ref:0} then <frame>x</frame> {@ref:1} and {@ref:1}",
      "pictures": [
        { "role": "crop", "field": "image_urls[0]", "n": 1 },
        { "role": "original", "ref": 0, "field": "image_urls[1]", "n": 2 },
        { "role": "reference", "ref": 1, "field": "image_urls[2]", "n": 3 }
      ],
      "pattern": "<frame>{n0}</frame>",
      "out": "<frame>1</frame> then <frame>x</frame> <frame>2</frame> and <frame>2</frame>",
      "left": [],
      "refs": [{ "ref": 0, "name": "<frame>1</frame>" }, { "ref": 1, "name": "<frame>2</frame>" }]
    },
    {
      "_comment": "the default pattern when none or an invalid one is given",
      "text": "from {@ref:0}",
      "pictures": [
        { "role": "crop", "field": "image", "n": 1 },
        { "role": "reference", "ref": 0, "field": "references[0]", "n": 2 }
      ],
      "pattern": "@img{n}",
      "out": "from image 2",
      "left": [],
      "refs": [{ "ref": 0, "name": "image 2" }]
    },
    {
      "_comment": "a reference the route leaves out, and one in a field of its own (Ideogram style)",
      "text": "{@ref:0} and {@ref:1} and {@ref:2}",
      "pictures": [
        { "role": "crop", "field": "image", "n": 1 },
        { "role": "reference", "ref": 1, "field": "style_reference_images[0]", "n": null },
        { "role": "mask", "field": "mask", "n": null }
      ],
      "pattern": "image {n}",
      "out": "{@ref:0} and {@ref:1} and {@ref:2}",
      "left": [{ "ref": 0, "why": "absent" }, { "ref": 1, "why": "unnumbered" }, { "ref": 2, "why": "absent" }],
      "refs": []
    },
    {
      "_comment": "the tokenizer names of Qwen Image 2.1",
      "text": "put {@ref:0} on the table",
      "pictures": [
        { "role": "crop", "field": "image1", "n": 1 },
        { "role": "reference", "ref": 0, "field": "image2", "n": 2 }
      ],
      "pattern": "<image{n}>",
      "out": "put <image2> on the table",
      "left": [],
      "refs": [{ "ref": 0, "name": "<image2>" }]
    },
    {
      "_comment": "no marker: nothing changes, a malformed marker is left for the safety net",
      "text": "plain text {@ref:x} @image2",
      "pictures": [{ "role": "crop", "field": "image", "n": 1 }],
      "pattern": "image {n}",
      "out": "plain text {@ref:x} @image2",
      "left": [],
      "refs": []
    }
  ]
}
